// Cloudflare Workers settings: worker.js serves the built site (dist/): neonsignsites.com, previews,
// and launched customer sites on their own domains (Cloudflare for SaaS custom hostnames).
// Cloudflare runs `node deploy.mjs --dry` (build) then `npx wrangler deploy` on every push to main.
{
  "name": "neon-sign-sites",
  "compatibility_date": "2026-11-01",
  "main": "worker.js",
  // Only neonsignsites.com and customer domains: no *.workers.dev address and no preview URLs
  // (they would bypass the Access login on /dashboard; worker.js refuses it there too).
  "workers_dev": false,
  "preview_urls": false,
  // Plain settings for the forms (forms.js). The Resend key is a secret set in the dashboard, not here.
  "vars": {
    "MAIL_FROM": "Neon Sign Sites <hello@neonsignsites.com>",
    "NOTIFY_TO": "alon@neonsignsites.com",
    "PAYPAL_MONTHLY_URL": "/subscribe",
    "PAYPAL_OWN_URL": "https://www.paypal.com/ncp/payment/8BEKHHQQHC7SN",
    // Preview requests are built by a GitHub Action in this repository (forms.js startBuild; secret GITHUB_DISPATCH_TOKEN).
    "GITHUB_REPO": "kelon33/neon-sign-sites"
  },
  // Preview visits and "Make it live" clicks for the dashboard (events.js). Created by Alon, 2026-11-27.
  "kv_namespaces": [{ "binding": "EVENTS", "id": "42bf638324ae44659d2d9dd1d2f753dd" }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
