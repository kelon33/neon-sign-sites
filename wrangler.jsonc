// Cloudflare Workers settings: serves the built site (dist/) as static files.
// Cloudflare runs `node deploy.mjs --dry` (build) then `npx wrangler deploy` on every push to main.
{
  "name": "neon-sign-sites",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
